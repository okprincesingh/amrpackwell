<IfModule mod_rewrite.c>
    RewriteEngine On

    # LOCAL (XAMPP): site lives in a subfolder, so RewriteBase must point at it.
    # PRODUCTION: change this single line to RewriteBase / before deploying.
    RewriteBase /amrpackwell/

    # Map administrative URLs under /admin to the php-admin/admin folder
    # External temporary redirect for the root /admin so the browser requests the actual login page
    RewriteRule ^admin/?$ php-admin/admin/login.php [R=302,L,QSA]
    # Pass through other /admin/* requests internally to php-admin/admin/
    RewriteRule ^admin/(.*)$ php-admin/admin/$1 [L,QSA]

    # ---- Dynamic blog detail pages ----
    RewriteRule ^blog/([a-z0-9-]+)/?$ blog-detail.php?slug=$1 [L,QSA]
    RewriteRule ^products/([a-z0-9-]+)/?$ product-detail.php?slug=$1 [L,QSA]
    RewriteRule ^product/?$ product.php [L,QSA]

    # CUSTOM REDIRECT
    RewriteRule ^paper-angle-board/?$ https://www.amrpackwell.com/paper-angle-board-manufacturer [R=301,L]
    # Redirect wooden-pallets to wooden-pallet-manufacturers
    RewriteRule ^wooden-pallets/?$ https://www.amrpackwell.com/wooden-pallet-manufacturers [R=301,L]

    # Redirect detail-pine-wooden-pallets
    RewriteRule ^detail-pine-wooden-pallets/?$ https://www.amrpackwell.com/detail-pine-wooden-pallet-manufacturers [R=301,L]
    # Redirect detail-plywood-pallets
    RewriteRule ^detail-plywood-pallets/?$ https://www.amrpackwell.com/detail-plywood-pallet-maufacturers [R=301,L]
    # Redirect corrugated-box
    RewriteRule ^corrugated-box/?$ https://www.amrpackwell.com/corrugated-box-manufacturers-in-noida [R=301,L]

    # Redirect index.html to homepage
    RewriteRule ^index\.html$ ./ [R=301,L]

    # Redirect .html URLs to clean URLs (skip header.html — it's a JS-fetched partial, not a page)
    # Only redirect when the original client request contained a .html path
    RewriteCond %{REQUEST_URI} !/header\.html$ [NC]
    RewriteCond %{THE_REQUEST} \s/[^\s]*\.html[?\s] [NC]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(.+)\.html$ $1 [R=301,L,NE]

    # Internally load .html file
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^([^/.]+)/?$ $1.html [L]

    # Redirect invalid URLs to homepage
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/$
    RewriteRule ^.*$ ./ [R=301,L]
</IfModule>

<IfModule mod_headers.c>

    # Prevent iframe embedding
    Header always set X-Frame-Options "SAMEORIGIN"

    # MIME sniffing protection
    Header always set X-Content-Type-Options "nosniff"

    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # HTTPS enforcement
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Content Security Policy
    Header set Content-Security-Policy "default-src 'self' https: data: 'unsafe-inline';"

</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php82" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit